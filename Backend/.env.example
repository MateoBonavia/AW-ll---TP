PORT=3000

# Datos de conexión a PostgreSQL. Los valores de ejemplo coinciden con
# el contenedor de postgre-sql/comandos.txt; cambiarlos fuera de desarrollo.
BD_HOST=localhost
BD_USER=root
BD_PASS=pass
BD_BD=tienda
BD_PORT=5432

# Clave para firmar los JWT. Obligatoria: usar un texto largo y aleatorio.
JWT_SECRET=

# Orígenes externos autorizados por CORS (separados por coma). Solo hace falta
# si el Front-End se abre desde otro servidor, como Live Server.
CORS_ORIGENES=http://localhost:5500

# Con NODE_ENV=production la cookie de sesión se marca como Secure (solo HTTPS).
NODE_ENV=development
